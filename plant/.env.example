# Template for the plant's .env — copy it to .env in this folder and change what your computer needs.
# Docker Compose reads .env from here. It is never committed and no AI assistant may open it
# (AGENTS.md); this template is committed.
# The plant has no secret to configure: its credentials are generated on the first start.

# The port of the demo's broker on this computer. Not 8883, so it can run next to another broker.
BUSPROOF_MQTT_PORT=8884

# The port of the broker for browsers (MQTT over WebSockets), and the port of the demo's web page.
BUSPROOF_WS_PORT=9001
BUSPROOF_WEB_PORT=8088
