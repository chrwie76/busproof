# Template for the test project's .env — copy it to .env in this folder and fill in what your
# setup needs. .env is never committed and no AI assistant may open it (AGENTS.md); this template
# is committed.
# BusProof reads these names from the environment, never from this file: load it with your shell
# or your editor. In CI, set the same names as repository variables, and secrets as repository
# secrets. Secrets stay empty in this file — always.

# Which environment from busproof.toml the tests run against: local, ci, ...
BUSPROOF_ENV=local

# --- MQTT broker -------------------------------------------------------------
# Address of the broker, with port: mqtt:// for plain TCP, mqtts:// for TLS.
# The demo plant's own broker (make demo) listens here.
BUSPROOF_MQTT_URL=mqtts://localhost:8884

# The path of the certificate authority that signed the broker's certificate, for mqtts:// when it
# is not one your system trusts. A path, never its contents. The demo's is ../plant/secrets/ca.crt.
BUSPROOF_MQTT_CA=

# Credentials, if your broker requires them. `make line-tests` fills them in itself; the demo's
# generated password is in ../plant/secrets/password.
BUSPROOF_MQTT_USERNAME=
BUSPROOF_MQTT_PASSWORD=
