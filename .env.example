# Template for .env — copy it to .env and fill in what your setup needs.
# .env is never committed and no AI assistant may open it (AGENTS.md); this template is committed.
# In CI, set the same names as repository variables, and secrets as repository secrets.
# Secrets stay empty in this file — always.

# Which environment from busproof.toml the tests run against: local, ci, ...
BUSPROOF_ENV=local

# --- MQTT broker -------------------------------------------------------------
# Address of the broker, with port: mqtt:// for plain TCP, mqtts:// for TLS.
# The demo plant's own broker (make demo) listens here.
BUSPROOF_MQTT_URL=mqtts://localhost:8884

# The port of the demo's broker on this computer. Not 8883, so it can run next to another broker.
BUSPROOF_MQTT_PORT=8884

# The port of the broker for browsers (MQTT over WebSockets), and the port of the demo's web page.
BUSPROOF_WS_PORT=9001
BUSPROOF_WEB_PORT=8088

# The path of the certificate authority that signed the broker's certificate, for mqtts:// when it
# is not one your system trusts. A path, never its contents. The demo's is in demo/secrets/ca.crt.
BUSPROOF_MQTT_CA=

# Credentials, if your broker requires them. `make demo` and its tests fill them in themselves; the
# demo's generated password is in demo/secrets/password.
BUSPROOF_MQTT_USERNAME=
BUSPROOF_MQTT_PASSWORD=
